{
  "name": "auto-kdp",
  "version": "0.1.0",
  "description": "Automated pipeline: niche → AI coloring-book pages → KDP-ready interior + cover PDFs",
  "type": "module",
  "scripts": {
    "plan": "tsx src/planner/index.ts",
    "generate": "tsx src/generator/index.ts",
    "validate": "tsx src/validator/index.ts",
    "review": "tsx src/reviewer/index.ts",
    "assemble": "tsx src/assembler/index.ts",
    "pipeline": "tsx src/pipeline.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "axios": "^1.9.0",
    "better-sqlite3": "^11.9.1",
    "dotenv": "^16.5.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.34.5",
    "yaml": "^2.8.3",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
